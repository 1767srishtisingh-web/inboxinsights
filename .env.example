# =============================================================================
#  Inbox Insights — Environment Configuration
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit your .env file to Git!
# =============================================================================

# ─── Flask Application ────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-byte-hex-string
DEBUG=false
HOST=0.0.0.0
PORT=5000

# BASE_URL: The public base URL used to generate signed PDF report links and OAuth callbacks.
# For local dev without a tunnel: http://localhost:5000
# For WhatsApp media attachments to work via Twilio, this MUST be a public HTTPS URL:
# e.g. using ngrok: https://xxxx-xx-xx.ngrok-free.app
BASE_URL=http://localhost:5000

# ─── Database & Storage Paths ────────────────────────────────────────────────
DB_PATH=data/inbox_insights.db
OUTPUT_DIR=output
LOGS_DIR=logs
TOKENS_DIR=tokens

# ─── Google OAuth 2.0 (Gmail Web Application Client) ─────────────────────────
# Go to https://console.cloud.google.com -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID of type "Web application"
# Add redirect URI: http://localhost:5000/oauth/callback (and your ngrok URL if using one)
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:5000/oauth/callback

# ─── Claude AI (Anthropic) ────────────────────────────────────────────────────
# Get an API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5
AI_MAX_RETRIES=3
AI_BATCH_SIZE=20

# ─── WhatsApp Delivery via Twilio Sandbox ─────────────────────────────────────
# 1. Sign up at https://www.twilio.com (free trial account)
# 2. Go to Console -> Messaging -> Try it out -> Send a WhatsApp message
# 3. Note the Twilio Sandbox phone number and your unique join keyword (e.g. "join brave-camel")
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_WORD=join your-sandbox-word

# ─── PDF Report Links ─────────────────────────────────────────────────────────
# Number of hours a signed report link (/r/<token>) remains valid
PDF_LINK_EXPIRY_HOURS=48

# ─── Gmail Fetch & Filters ────────────────────────────────────────────────────
MAX_EMAILS_PER_ACCOUNT=50
EMAIL_QUERY_FILTER=in:inbox -in:spam -in:promotions

# ─── Security & Throttling ───────────────────────────────────────────────────
# Number of failed login attempts before locking out the WhatsApp number
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ─── Networking & Resilience ─────────────────────────────────────────────────
HTTP_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
