# ─── Gmail OAuth ────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# (OAuth client ID, type "Desktop app"). Save the JSON it gives you
# somewhere OUTSIDE version control and point this at it.
GMAIL_CREDENTIALS_FILE=credentials.json

# ─── Claude AI (Anthropic) ──────────────────────────────────────
# Free credit on signup → https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5

# ─── WhatsApp via Twilio (free Sandbox — no paid plan needed) ───
# 1. Sign up at https://www.twilio.com
# 2. Console → Messaging → Try it out → WhatsApp Sandbox
# 3. Each user must send "join <sandbox-word>" from their own phone
#    to the sandbox number before they can receive messages.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to false to refuse sending rather than upload the PDF to a public,
# anonymous file host (see README privacy note).
PDF_PUBLIC_HOST_ENABLED=true

# ─── Automation ──────────────────────────────────────────────────
# 24-hour HH:MM, local time. Used by scheduler.py.
REPORT_TIME=17:00

# ─── App Settings ────────────────────────────────────────────────
MAX_EMAILS_PER_ACCOUNT=50
EMAIL_QUERY_FILTER=in:inbox -in:spam -in:promotions
OUTPUT_DIR=output
LOGS_DIR=logs
TOKENS_DIR=tokens
USERS_CONFIG_FILE=users/users.json

# ─── Reliability ─────────────────────────────────────────────────
HTTP_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
AI_MAX_RETRIES=3
